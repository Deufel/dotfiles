#!/bin/bash
# Save current dotfiles state to git.

ok()   { echo "✓ $1"; }
info() { echo "→ $1"; }

info "updating package lists"
pacman -Qqe | grep -v "$(pacman -Qqm)" > $HOME/dotfiles/packages.txt
pacman -Qqem > $HOME/dotfiles/aur.txt
ok "package lists updated"

info "committing to git"
cd $HOME/dotfiles
git add .
git diff --cached --quiet && echo "nothing to commit" && exit 0
git commit -m "sync: $(date +%Y-%m-%d)"
git push
ok "dotfiles saved"
