#!/bin/bash
# Minimal directory tree.

SKIP=".git|.venv"
MAX=${1:-999}

walk() {
    local dir=$1
    local depth=$2
    local prefix=$3

    [ "$depth" -gt "$MAX" ] && return

    local items=()
    while IFS= read -r item; do
        items+=("$item")
    done < <(ls -A "$dir" 2>/dev/null | grep -vE "^($SKIP)$")

    local count=${#items[@]}
    local i=0

    for item in "${items[@]}"; do
        local path="$dir/$item"
        i=$((i + 1))

        if [ "$i" -eq "$count" ]; then
            echo "${prefix}└── $item"
            [ -d "$path" ] && walk "$path" $((depth + 1)) "${prefix}    "
        else
            echo "${prefix}├── $item"
            [ -d "$path" ] && walk "$path" $((depth + 1)) "${prefix}│   "
        fi
    done
}

echo "."
walk "." 1 ""
