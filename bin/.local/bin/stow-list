#!/bin/bash
# Show all stow-managed symlinks, grouped by package, with git status.

dotfiles=~/dotfiles
symlinks=()

# cache symlinks once
while IFS= read -r l; do
  symlinks+=("$l")
done < <(find "$HOME" -maxdepth 5 -type l 2>/dev/null)

echo "── dotfiles ──────────────────────────"

total=0
while IFS= read -r pkg_path; do
  pkg=$(basename "$pkg_path")
  count=0
  example=""

  for link in "${symlinks[@]}"; do
    [[ $(readlink "$link") != *"dotfiles/$pkg"* ]] && continue
    count=$((count + 1))
    if [ -z "$example" ]; then
      rel=${link/#$HOME\//}
      [[ "$rel" == */* ]] && example="$(dirname "$rel")/" || example="$rel"
    fi
  done

  [ "$count" -eq 0 ] && continue
  printf "  %-10s %-4s %s\n" "$pkg" "$count" "$example"
  total=$((total + count))
done < <(find "$dotfiles" -maxdepth 1 -mindepth 1 -type d)

broken=$(find "$HOME" -maxdepth 5 -type l ! -e 2>/dev/null | wc -l | tr -d ' ')
echo "─────────────────────────── $total links"
[ "$broken" -gt 0 ] && echo "⚠  $broken broken symlinks" >&2

git_branch=$(git -C "$dotfiles" branch --show-current 2>/dev/null)
git_clean=$(git -C "$dotfiles" status --porcelain 2>/dev/null)
[ -z "$git_clean" ] && git_state="✓ clean" || git_state="✗ uncommitted changes"
echo "~/dotfiles  $git_branch  $git_state"
