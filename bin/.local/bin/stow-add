#!/bin/bash

usage() {
  echo "usage: stow-add <package> <file>"
  exit 1
}

[ -z "$1" ] && usage
[ -z "$2" ] && usage
[ ! -f "$2" ] && echo "✗ not found: $2" && exit 1
[ -L "$2" ] && echo "✗ already stowed: $2" && exit 1

pkg=${1%/}
file=$2
rel=${file/#$HOME\//}

mkdir -p ~/dotfiles/$pkg/$(dirname $rel)
cp "$file" ~/dotfiles/$pkg/$rel
rm "$file"
stow $pkg

echo "✓ $file → ~/dotfiles/$pkg/$rel"
