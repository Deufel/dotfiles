#!/bin/bash
# Usage: stow-add <package> <file-path>
# Example: stow-add hypr ~/.config/hypr/hypridle.conf

PACKAGE=$1
FILE=$2
DOTFILES=~/dotfiles

if [ -z "$PACKAGE" ] || [ -z "$FILE" ]; then
    echo "Usage: stow-add <package> <file-path>"
    exit 1
fi

RELATIVE=${FILE/#$HOME\//}
mkdir -p "$DOTFILES/$PACKAGE/$(dirname $RELATIVE)"
cp "$FILE" "$DOTFILES/$PACKAGE/$RELATIVE"
rm "$FILE"
stow $PACKAGE

echo "✓ $FILE → $DOTFILES/$PACKAGE/$RELATIVE"
